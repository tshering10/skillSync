    },
    {
      "name": "🧠 Matching",
      "description": "Resume-to-job semantic matching using pgvector + sentence-transformers.\n\nBase path: /api/v1/matching/",
      "item": [
        {
          "name": "Match Resume to Job",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"resume_id\": \"<resume-uuid-here>\",\n    \"job_id\": \"<job-uuid-here>\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/matching/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "matching", ""]
            },
            "description": "Trigger a semantic match between a resume and a job.\n\n**Auth:** Bearer token required.\n\n**Response:** Match score (cosine similarity), matched skills, missing skills, and overall match percentage."
          },
          "response": []
        },
        {
          "name": "List Match Results",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/matching/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "matching", ""]
            },
            "description": "List all previous match results for the authenticated user."
          },
          "response": []
        },
        {
          "name": "Get Match Detail",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/matching/:id/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "matching", ":id", ""],
              "variable": [
                { "key": "id", "value": "", "description": "Match result UUID" }
              ]
            },
            "description": "Retrieve a specific match result by UUID, including full skill breakdown."
          },
          "response": []
        }
      ]
    },
