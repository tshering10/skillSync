              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Senior Python Developer\",\n    \"company\": \"TechCorp Inc.\",\n    \"description\": \"We are looking for a senior Python developer with Django and PostgreSQL experience to join our growing team.\",\n    \"location\": \"Remote\",\n    \"job_type\": \"full_time\",\n    \"experience_level\": \"senior\",\n    \"required_skills\": [\"Python\", \"Django\", \"PostgreSQL\", \"REST APIs\", \"Docker\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/jobs/",
