# Django Environment Variables
DEBUG=True
SECRET_KEY=change-me-in-production-use-a-strong-random-key
ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL & pgvector Database Settings
POSTGRES_DB=skillsync
POSTGRES_USER=skillsync
POSTGRES_PASSWORD=skillsync_secret
DATABASE_URL=postgresql://skillsync:skillsync_secret@db:5432/skillsync

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

